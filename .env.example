# Local development works without an env file (SQLite in .local/, no email sent).
# For hosted deployments, set these in your hosting dashboard:
# APP_BACKEND=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Optional canonical public origin. Hosting-provided URLs are used when unset.
# NEXT_PUBLIC_SITE_URL=https://YOUR-ACTUAL-DOMAIN

# Never add a service-role/secret key or a database password to NEXT_PUBLIC_.
